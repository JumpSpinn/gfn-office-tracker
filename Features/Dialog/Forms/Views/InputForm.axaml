<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:vm="using:OfficeTracker.Features.Dialog.Forms.ViewModels"
             x:DataType="vm:InputFormViewModel"
             x:Class="OfficeTracker.Features.Dialog.Forms.Views.InputForm">
	<StackPanel Orientation="Vertical" Spacing="20">
		<TextBlock
			IsVisible="{Binding DescriptionVisible}"
			TextWrapping="Wrap"
			Text="{Binding Description}"
		/>
		<Grid RowDefinitions="Auto,Auto" HorizontalAlignment="Stretch" RowSpacing="5">
			<TextBlock
				Grid.Row="0"
				Text="{Binding Title}"
				TextWrapping="Wrap"
				HorizontalAlignment="Stretch"
			/>
			<TextBox
				Grid.Row="1"
				HorizontalAlignment="Stretch"
				TextAlignment="Left"
				FontFamily="{DynamicResource GlobalFont}"
				Watermark="{Binding Placeholder}"
				Text="{Binding Input}"
			/>
		</Grid>
	</StackPanel>
</UserControl>

